# Root Expo configuration: PUBLIC values only. No OpenAI or Supabase secret/service-role keys.
# Use the HTTPS origin printed by your backend tunnel, with no /chat suffix.
EXPO_PUBLIC_COMPANION_URL=https://your-backend.example.com
# Must be the same project as server/.env SUPABASE_URL.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon JWT or sb_publishable_ key, same as server/.env SUPABASE_ANON_KEY.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Older EXPO_PUBLIC_SUPABASE_KEY is supported only for migration. Rename/remove it.
# Restart npx expo start --clear after changing these values.

# Server only. Never put this key in EXPO_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
PORT=8787
# Default loopback. Set 0.0.0.0 only behind a TLS reverse proxy for deployment.
HOST=127.0.0.1
# This foundation uses per-process limits. Run one backend instance.
MAX_DAILY_REQUESTS=1000

# Server .env (separate from the root Expo .env). Never put this key in EXPO_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Same project/public anon or publishable key as the app. Never a service-role key.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
PORT=8787
# Keep loopback for local HTTPS tunnels; no Wi-Fi IP or 0.0.0.0 is needed.
# For deployment, set 0.0.0.0 only behind a TLS reverse proxy.
HOST=127.0.0.1
# This foundation uses per-process limits. Run one backend instance.
MAX_DAILY_REQUESTS=1000
